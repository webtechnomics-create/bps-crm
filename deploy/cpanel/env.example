# Copy this file to ".env" in the same folder and fill the values.
# (Or add each one under "Environment variables" in cPanel > Setup Node.js App.)
NODE_ENV="production"
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
AUTH_SECRET="put-a-long-random-string-here"
APP_URL="https://crm.yourschool.in"

# First login (used once by setup-db.js)
SUPERADMIN_EMAIL="you@yourschool.in"
SUPERADMIN_PASSWORD="choose-a-strong-password"

# Website enquiry form
WEBSITE_FORM_KEY=""
WEBSITE_ALLOWED_ORIGINS="https://yourschool.in,https://www.yourschool.in"

# Meta Lead Ads (fill later)
META_APP_SECRET=""
META_VERIFY_TOKEN=""
META_PAGE_ACCESS_TOKEN=""
META_GRAPH_VERSION="v21.0"
META_DATASET_ID=""
META_CAPI_ACCESS_TOKEN=""
META_AD_ACCOUNT_ID=""
META_ADS_ACCESS_TOKEN=""

# Google Ads lead form (fill later)
GOOGLE_LEAD_FORM_KEY=""
