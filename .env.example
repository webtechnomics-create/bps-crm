# ---- Core ----
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/bps_crm"
# Long random string: run `openssl rand -base64 48`
AUTH_SECRET=""
# Public URL of the CRM, e.g. https://crm.yourschooldomain.com
APP_URL="http://localhost:3000"

# ---- Website enquiry form ----
# Any random string. Website form must send it as header `x-api-key` (or ?key=)
WEBSITE_FORM_KEY=""
# Comma separated list of website origins allowed to post the form (CORS)
WEBSITE_ALLOWED_ORIGINS="https://www.yourschooldomain.com,https://yourschooldomain.com"

# ---- Meta (Facebook / Instagram Lead Ads) ----
META_APP_SECRET=""
# Any random string, also typed in Meta App > Webhooks > Verify token
META_VERIFY_TOKEN=""
# Long-lived Page access token with leads_retrieval permission
META_PAGE_ACCESS_TOKEN=""
META_GRAPH_VERSION="v21.0"
# For sending conversions back (Conversions API for CRM)
META_DATASET_ID=""
META_CAPI_ACCESS_TOKEN=""

# ---- Google Ads Lead Form ----
# The "Key" you type in Google Ads lead form > Webhook integration
GOOGLE_LEAD_FORM_KEY=""
